DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo
# Em desenvolvimento local, estas origens comuns já são aceitas por padrão.
# Substitua pela origem exata do frontend em produção; nunca use *.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
# Se definido, deve conter as origens que também podem enviar requisições com CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Em produção com frontend cross-site, use SameSite=None e Secure=True (HTTPS obrigatório).
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=
# Em produção com HTTPS, configure DJANGO_DEBUG=False, DJANGO_SECURE_SSL_REDIRECT=True
# e um DJANGO_SECURE_HSTS_SECONDS apropriado para seu domínio.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

POSTGRES_DB=finances
POSTGRES_USER=finances
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Chave da API Bolsai usada apenas pelo backend.
BOLSAI_API_KEY=

# Token da brapi usado apenas pelo backend.
BRAPI_API_TOKEN=
